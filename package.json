    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.28.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
